# ---- Web server ----
FLASK_ENV=production
# 127.0.0.1 = local only (recommended; put a VPN/HTTPS proxy in front for remote access)
HOST=127.0.0.1
PORT=5000
# REQUIRED: long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=
SECRET_KEY=
# Set true when served over HTTPS (reverse proxy / tunnel)
COOKIE_SECURE=false
# Set true only if behind a trusted reverse proxy that sets X-Forwarded-* headers
TRUST_PROXY=false
SESSION_HOURS=12

# ---- Storage / logging ----
DATABASE_PATH=data/linkedin_ai.db
LOG_DIR=logs
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ---- Ollama (text only) ----
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=gpt-oss:20b-cloud
AI_TIMEOUT=120

# ---- Monitoring / engagement defaults (editable later in the dashboard) ----
POLL_INTERVAL=60
LOOKBACK_DAYS=7
# manual | automatic | mixed   (see README: mixed = auto-like, comments need approval)
PUBLISHING_MODE=mixed
AUTO_LIKE=true
AUTO_COMMENT=false
LIKE_GAP=20
AUTO_AI=false
AI_GAP=20
AI_HOURLY_LIMIT=30
LIKE_MAX_AGE_HOURS=72
COMMENT_COOLDOWN=60
POST_RETRY_COOLDOWN=300
MAX_RETRIES=5
BACKOFF_BASE=30
BACKOFF_MAX=1800
BATCH_SIZE=5
MAX_QUEUE=200
MAX_COMMENT_LENGTH=300

# ---- Browser ----
BROWSER_PROFILE_DIR=data/browser_profile
# false = visible window (needed for first login if you don't use scripts/login.py)
BROWSER_HEADLESS=true
# Optional: path to a system Chromium/Chrome (useful on Termux / ARM)
CHROMIUM_EXECUTABLE=
BROWSER_NO_SANDBOX=false
# Abort image/video/font requests (saves bandwidth; alt text is still read from the DOM)
BLOCK_MEDIA=true

# ---- Worker ----
AUTOSTART_WORKER=true
WORKER_RESTART_DELAY=10